{
  "$schema": "https://biomejs.dev/schemas/2.4.2/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.js",
      "**/*.mjs",
      "**/*.json",
      "!**/.next",
      "!**/dist",
      "!**/graphify-out",
      "!**/.graphify",
      "!packages/db/drizzle/**/*"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always"
    }
  },
  "json": { "formatter": { "trailingCommas": "none" } },
  "linter": {
    "enabled": true,
    "domains": { "next": "recommended", "react": "recommended" },
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "off",
        "noArrayIndexKey": "off",
        "noConsole": { "level": "error", "options": { "allow": ["assert"] } }
      },
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/logger/src/**/*.ts",
        "packages/db/src/seed/**/*.ts",
        "scripts/**",
        "**/benchmark.mjs",
        "**/*.test.ts",
        "**/*.test.tsx",
        "test/**/*.ts"
      ],
      "linter": { "rules": { "suspicious": { "noConsole": "off" } } }
    },
    {
      "includes": ["apps/web/app/**", "apps/admin/app/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@personus/db": "Route/action code must not import the raw db client — use principal-gated services from '@personus/db/services'. (authz chokepoint; system-only exceptions need an inline biome-ignore)"
                }
              }
            }
          }
        }
      }
    }
  ],
  "assist": { "enabled": true }
}
