{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_COPILOT_RUNTIME_URL"
      ]
    },
    "lint": {},
    "type-check": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:generate": { "cache": false },
    "db:migrate": { "cache": false },
    "db:push": { "cache": false },
    "db:studio": { "cache": false },
    "db:seed": { "cache": false }
  },
  "globalEnv": [
    "DATABASE_URL",
    "DATABASE_URL_UNPOOLED",
    "AUTH_PROVIDER",
    "FLAGS_PROVIDER",
    "CLERK_SECRET_KEY",
    "OPENAI_API_KEY",
    "MASTRA_LOG_LEVEL",
    "LOG_LEVEL",
    "CLERK_WEBHOOK_SECRET",
    "NODE_ENV"
  ],
  "globalDependencies": ["tsconfig.json", ".env"]
}
