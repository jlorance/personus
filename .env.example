# ─── Database (Neon Postgres) ────────────────────────────────────────────────
# Pooled URL for the app runtime; unpooled/direct URL for drizzle-kit migrations.
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.us-east-1.aws.neon.tech/personus?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/personus?sslmode=require

# ─── AuthN provider (pluggable) ──────────────────────────────────────────────
# clerk (default, working) | workos (stub + implementation guide)
AUTH_PROVIDER=clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx

# ─── Feature flags provider (OpenFeature, pluggable) ─────────────────────────
# db (default, backed by system_settings) | posthog (stub) | launchdarkly (stub)
FLAGS_PROVIDER=db
# POSTHOG_API_KEY=phc_xxx
# LAUNCHDARKLY_SDK_KEY=sdk-xxx

# ─── Token compression (pluggable, off by default) ──────────────────────────
# noop (default, passthrough) | headroom (requires HEADROOM_PROXY_URL; gated on
# the vetting spike before enabling in any live path)
COMPRESSION_PROVIDER=noop
# HEADROOM_PROXY_URL=https://headroom.internal
# HEADROOM_API_KEY=hr_xxx

# ─── AI (Mastra + OpenAI) ────────────────────────────────────────────────────
OPENAI_API_KEY=sk-xxx
MASTRA_LOG_LEVEL=info
# Logger level fallback when MASTRA_LOG_LEVEL is unset: debug | info | warn | error
# LOG_LEVEL=info

# ─── CopilotKit runtime ──────────────────────────────────────────────────────
NEXT_PUBLIC_COPILOT_RUNTIME_URL=/api/copilotkit

# ─── PlatformChannels (Mastra channels — bots; later pass) ───────────────────
# Setting a bot token enables that channel; its webhook secret is then required
# (enforced at startup by validateEnv — hard error in production).
# SLACK_BOT_TOKEN=xoxb-xxx
# SLACK_SIGNING_SECRET=xxx          # required when SLACK_BOT_TOKEN is set
# DISCORD_BOT_TOKEN=xxx
# DISCORD_PUBLIC_KEY=xxx            # required when DISCORD_BOT_TOKEN is set
# TELEGRAM_BOT_TOKEN=xxx
# TELEGRAM_WEBHOOK_SECRET=xxx       # required when TELEGRAM_BOT_TOKEN is set

# ─── Operational tuning knobs (optional; safe defaults live in code) ─────────
# Declared and validated in @personus/env; must be positive integers if set.
# TIMEOUT_LLM_MS=60000              # LLM call timeout (default 60000)
# TIMEOUT_EMBED_MS=30000            # embedding call timeout (default 30000)
# TIMEOUT_DB_MS=5000                # DB call timeout (default 5000)
# SETTINGS_CACHE_TTL_MS=60000       # system_settings per-key cache TTL (default 60000)
